diff --git a/bitcoin/tx.c b/bitcoin/tx.c
index dabd52556..53b164c7e 100644
--- a/bitcoin/tx.c
+++ b/bitcoin/tx.c
@@ -935,8 +935,9 @@ size_t bitcoin_tx_input_witness_weight(enum utxotype utxotype)
 		 * to `1` and witness: <remote_sig>
 		 * Otherwise, this output is a simple P2WPKH to `remotepubkey`.
 		 */
-		/* In practice, these predate anchors, so: */
-		return 1 + 1 + bitcoin_tx_input_sig_weight();
+		/* Include the P2WSH witness script, including the supported lease
+		 * CSV value. bitcoin_tx_input_weight counts the witness elements. */
+		return bitcoin_tx_input_sig_weight() + 1 + 34 + 1 + 3 + 1;
 	case UTXO_P2TR:
 		return 1 + 64;
 	}
diff --git a/lightningd/peer_htlcs.c b/lightningd/peer_htlcs.c
index c6c1991da..ac127d6fc 100644
--- a/lightningd/peer_htlcs.c
+++ b/lightningd/peer_htlcs.c
@@ -993,6 +993,8 @@ fail:
  * Data passed to the plugin, and as the context for the hook callback
  */
 struct htlc_accepted_hook_payload {
+	/* Recovery-only replay of an already committed final HTLC. */
+	bool closing_replay;
 	struct route_step *route_step;
 	/* NULL if it couldn't be parsed! */
 	struct onion_payload *payload;
@@ -1313,6 +1315,13 @@ htlc_accepted_hook_final(struct htlc_accepted_hook_payload *request STEALS)
 
 	request->hin->status = tal_free(request->hin->status);
 
+	/* Continue/forward_to must never initiate new work after closing. */
+	if (request->closing_replay) {
+		local_fail_in_htlc(hin, take(towire_permanent_channel_failure(NULL)));
+		tal_free(request);
+		return;
+	}
+
 	/* Hand the payload to the htlc_in since we'll want to have that info
 	 * handy for the hooks and notifications. */
 	request->hin->payload = tal_steal(request->hin, request->payload);
@@ -1540,7 +1549,11 @@ static bool peer_accepted_htlc(const tal_t *ctx,
 	 *
 	 *   - SHOULD fail to route any HTLC added after it has sent `shutdown`.
 	 */
-	if (!replay && !channel_state_can_add_htlc(channel->state)) {
+	if (!channel_state_can_add_htlc(channel->state)
+	    && !(replay && (channel->state == CHANNELD_SHUTTING_DOWN
+			   || channel->state == AWAITING_UNILATERAL
+			   || channel->state == FUNDING_SPEND_SEEN
+			   || channel->state == ONCHAIN))) {
 		*failmsg = towire_permanent_channel_failure(ctx);
 		log_debug(channel->log,
 			  "Rejecting their htlc %"PRIu64
@@ -1586,7 +1599,15 @@ static bool peer_accepted_htlc(const tal_t *ctx,
 		goto fail;
 	}
 
+	/* Closing replay can recover a final preimage, never forward. */
+	if (!channel_state_can_add_htlc(channel->state)
+	    && rs->nextcase != ONION_END) {
+		*failmsg = towire_permanent_channel_failure(ctx);
+		goto fail;
+	}
+
 	hook_payload = tal(NULL, struct htlc_accepted_hook_payload);
+	hook_payload->closing_replay = replay && !channel_state_can_add_htlc(channel->state);
 
 	hook_payload->route_step = tal_steal(hook_payload, rs);
 	hook_payload->payload = onion_decode(hook_payload,
diff --git a/lightningd/plugin.c b/lightningd/plugin.c
index c1b330cec..f40f565a6 100644
--- a/lightningd/plugin.c
+++ b/lightningd/plugin.c
@@ -261,8 +261,9 @@ static void destroy_plugin(struct plugin *p)
 	reqs = tal_arr(NULL, struct jsonrpc_request *, 0);
 	strmap_iterate(&p->pending_requests, request_add, &reqs);
 
-	/* Don't fail requests if we're exiting anyway! */
-	if (p->plugins->ld->state != LD_STATE_SHUTDOWN) {
+	/* An important plugin must not advance outstanding hook chains while
+	 * its death is shutting down the daemon. Free requests without callbacks. */
+	if (p->plugins->ld->state != LD_STATE_SHUTDOWN && !p->important) {
 		for (size_t i = 0; i < tal_count(reqs); i++)
 			plugin_terminated_fail_req(p, reqs[i]);
 	}
@@ -275,10 +276,6 @@ static void destroy_plugin(struct plugin *p)
 					       &p->subscriptions[i]);
 	}
 
-	/* If this was last one manifests were waiting for, handle deps */
-	if (p->plugin_state == AWAITING_GETMANIFEST_RESPONSE)
-		check_plugins_manifests(p->plugins, p->plugins->ld->log);
-
 	/* Daemon shutdown overrules plugin's importance; aborts init checks */
 	if (p->plugins->ld->state == LD_STATE_SHUTDOWN) {
 		/* But return if this was the last plugin! */
@@ -289,18 +286,23 @@ static void destroy_plugin(struct plugin *p)
 		return;
 	}
 
-	/* If this was the last one init was waiting for, handle cmd replies */
-	if (p->plugin_state == AWAITING_INIT_RESPONSE)
-		check_plugins_initted(p->plugins);
-
 	/* Now check if the dying plugin is important.  */
 	if (p->important) {
 		log_broken(p->log,
 			   "Plugin marked as important, "
 			   "shutting down lightningd!");
 		lightningd_exit(p->plugins->ld, 1);
+		return;
 	}
 
+	/* If this was last one manifests were waiting for, handle deps */
+	if (p->plugin_state == AWAITING_GETMANIFEST_RESPONSE)
+		check_plugins_manifests(p->plugins, p->plugins->ld->log);
+
+	/* If this was the last one init was waiting for, handle cmd replies */
+	if (p->plugin_state == AWAITING_INIT_RESPONSE)
+		check_plugins_initted(p->plugins);
+
 	if (tal_count(p->custom_msgs))
 		tell_connectd_custommsgs(p->plugins);
 
